{
  "name": "pokemystery",
  "private": true,
  "version": "0.1.0",
  "description": "PokeMystery - an unofficial Pokemon guessing game (Akinator-style) on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply pokemystery-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pokemystery-db --remote",
    "data:fetch": "tsx scripts/sync/fetch.ts",
    "data:sync:local": "tsx scripts/sync/fetch.ts && tsx scripts/sync/build-sql.ts && tsx scripts/sync/apply.ts --local",
    "data:sync:remote": "tsx scripts/sync/fetch.ts && tsx scripts/sync/build-sql.ts && tsx scripts/sync/apply.ts --remote",
    "data:validate": "tsx scripts/validate.ts",
    "data:seed:test": "tsx scripts/sync/build-sql.ts --fixture && tsx scripts/sync/apply.ts --local --fixture"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
