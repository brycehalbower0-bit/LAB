{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokemystery",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokemystery-db",
      // Placeholder ID for local development. For remote deploys, create the
      // database with `wrangler d1 create pokemystery-db` and paste the real
      // UUID here (see docs/DEPLOYMENT.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI: optional natural-language fallback parser. The deterministic
  // parser handles most questions; AI is only consulted when it fails and
  // AI_PARSER_ENABLED=true. Workers AI is a REMOTE binding: enabling it makes
  // `vite dev` require Cloudflare credentials (wrangler login /
  // CLOUDFLARE_API_TOKEN). Uncomment to enable, then set
  // AI_PARSER_ENABLED=true and rerun `wrangler types`.
  // "ai": {
  //   "binding": "AI"
  // },
  "vars": {
    // Non-secret configuration. Secrets belong in .dev.vars / wrangler secret.
    "APP_NAME": "PokeMystery",
    "AI_PARSER_ENABLED": "false",
    "AI_PARSER_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  }
}
